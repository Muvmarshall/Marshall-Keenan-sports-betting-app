{
  "name": "parlay-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "server",
    "web"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace web",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace packages/shared && npm run build --workspace server && npm run build --workspace web",
    "seed": "npm run seed --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "test": "npm run test --workspace packages/shared"
  },
  "engines": {
    "node": ">=20"
  }
}
